@page "/"
@inherits StateComponent

<PageTitle>Frigo</PageTitle>

<div class="row-between">
    <h1 class="place-title">@StorageGuide.LocationLabel(Location)</h1>
    <button class="icon-btn" title="Synchroniser" disabled="@(State.Sync == SyncStatus.Syncing)" @onclick="() => State.SyncAsync()">⟳</button>
</div>
<p class="place-sub">@Summary</p>

@if (State.Sync is SyncStatus.LocalOnly or SyncStatus.NoHousehold)
{
    <p class="notice small">Données sur cet appareil seulement. <a href="reglages">Connecte-toi et rejoins le foyer</a> pour partager l'inventaire.</p>
}
else if (State.Sync == SyncStatus.Pending)
{
    <p class="notice small">@(State.PendingCount) modification(s) en attente d'envoi. @State.SyncError</p>
}

<div class="seg" role="tablist">
    @foreach (var location in Enum.GetValues<StorageLocation>())
    {
        var loc = location;
        int urgent = UrgentCount(loc);
        <button role="tab" aria-selected="@(loc == Location ? "true" : "false")" class="@(loc == Location ? "on" : "")" @onclick="() => Location = loc">
            @StorageGuide.LocationLabel(loc)
            @if (urgent > 0)
            {
                <span class="dot" aria-label="@urgent à manger bientôt"></span>
            }
        </button>
    }
</div>

@if (Here.Count > 6)
{
    <input class="search" type="search" placeholder="Rechercher…" @bind="_search" @bind:event="oninput" />
}

@if (Visible.Count == 0)
{
    <section class="empty">
        @if (Here.Count == 0)
        {
            <p>Rien ici pour l'instant.</p>
            <a class="btn primary" href="ajouter">Ajouter un article</a>
        }
        else
        {
            <p class="muted">Aucun article ne correspond.</p>
        }
    </section>
}
else
{
    var first = Visible.Where(r => r.Freshness.Level is FreshnessLevel.Expired or FreshnessLevel.Soon).ToList();
    var rest = Visible.Where(r => r.Freshness.Level is FreshnessLevel.Fresh or FreshnessLevel.Unknown).ToList();

    if (first.Count > 0)
    {
        <h2 class="section">À manger d'abord</h2>
        <ul class="labels">
            @foreach (var row in first)
            {
                <ItemLabel Item="row.Item" Freshness="row.Freshness" />
            }
        </ul>
    }
    if (rest.Count > 0)
    {
        if (first.Count > 0)
        {
            <h2 class="section">Le reste</h2>
        }
        <ul class="labels">
            @foreach (var row in rest)
            {
                <ItemLabel Item="row.Item" Freshness="row.Freshness" />
            }
        </ul>
    }
}

@code {
    /// <summary>Selected place, kept while navigating so "Ajouter" and "back" stay on the same shelf.</summary>
    public static StorageLocation? LastLocation { get; set; }

    private string _search = "";

    private StorageLocation Location
    {
        get => LastLocation ?? DefaultLocation;
        set
        {
            LastLocation = value;
            _search = "";
        }
    }

    /// <summary>First visit: open where the most urgent item is, otherwise the fridge.</summary>
    private StorageLocation DefaultLocation =>
        State.Alerts.Count > 0 ? State.Alerts[0].Item.Location : StorageLocation.Fridge;

    private List<InventoryItem> Here => State.Items.Where(i => i.Location == Location).ToList();

    private int UrgentCount(StorageLocation location) => State.Alerts.Count(a => a.Item.Location == location);

    private string Summary
    {
        get
        {
            int count = Here.Count;
            string items = count == 1 ? "1 article" : $"{count} articles";
            int urgent = UrgentCount(Location);
            return urgent > 0 ? $"{items}, dont {urgent} à manger bientôt" : items;
        }
    }

    /// <summary>Items of the selected place, most urgent first; items without a date at the end, by name.</summary>
    private List<(InventoryItem Item, Freshness Freshness)> Visible
    {
        get
        {
            var today = AppState.Today;
            IEnumerable<InventoryItem> items = Here;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                items = items.Where(i => i.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase));
            }
            return items
                .Select(i => (Item: i, Freshness: FreshnessCalculator.Evaluate(i, today)))
                .OrderBy(r => r.Freshness.DaysLeft ?? int.MaxValue)
                .ThenBy(r => r.Item.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
    }
}
